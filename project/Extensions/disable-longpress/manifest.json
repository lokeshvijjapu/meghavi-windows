{
  "manifest_version": 3,
  "name": "Kiosk Lock",
  "version": "1.0",
  "description": "Disables long-press and text selection for kiosk use",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_start"
    }
  ]
}
